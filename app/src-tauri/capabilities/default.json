{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core, event, dialog and file-save permissions for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/pwilkin/trellis.cpp" },
        { "url": "https://huggingface.co/ilintar/trellis2-gguf" },
        { "url": "https://huggingface.co/microsoft/TRELLIS.2-4B" },
        { "url": "https://github.com/facebookresearch/dinov3/blob/main/LICENSE.md" },
        { "url": "https://github.com/ZhengPeng7/BiRefNet/blob/main/LICENSE" }
      ]
    },
    "fs:default",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**/*.png" },
        { "path": "**/*.PNG" },
        { "path": "**/*.jpg" },
        { "path": "**/*.JPG" },
        { "path": "**/*.jpeg" },
        { "path": "**/*.JPEG" },
        { "path": "**/*.webp" },
        { "path": "**/*.WEBP" },
        { "path": "**/*.bmp" },
        { "path": "**/*.BMP" },
        { "path": "**/*.gif" },
        { "path": "**/*.GIF" },
        { "path": "**/*.glb" },
        { "path": "**/*.GLB" },
        { "path": "$APPLOCALDATA/triastasis/gallery-v1" },
        { "path": "$APPLOCALDATA/triastasis/gallery-v1/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "**/*.glb" },
        { "path": "**/*.GLB" }
      ]
    }
  ]
}
