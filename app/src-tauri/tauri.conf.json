{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Triastasis",
  "version": "0.0.1-alpha.1",
  "identifier": "com.diethos.triastasis",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Triastasis",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' blob: data: ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "licenses/Triastasis-LICENSE.txt",
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../node_modules/three/LICENSE": "licenses/three-LICENSE.txt",
      "../node_modules/@tauri-apps/api/LICENSE_MIT": "licenses/Tauri-LICENSE-MIT.txt",
      "../node_modules/@tauri-apps/api/LICENSE_APACHE-2.0": "licenses/Tauri-LICENSE-APACHE-2.0.txt",
      "../public/fonts/LICENSE.txt": "licenses/Inter-LICENSE.txt",
      "../public/icons/LICENSE-lucide.txt": "licenses/Lucide-LICENSE.txt"
    },
    "targets": ["deb", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Local image-to-3D generation",
    "longDescription": "Triastasis runs Microsoft TRELLIS.2 image-to-3D reconstruction locally via trellis.cpp and previews the result in an interactive 3D viewer."
  }
}
